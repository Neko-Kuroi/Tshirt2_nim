+  let (year, month, day) = civilFromDays(days)
+  if year < 1 or year > 9999:
+    return v
+  align($year, 4, '0') & "/" & pad2(month) & "/" & pad2(day) & " " &
+    pad2(secs div 3600) & ":" & pad2((secs mod 3600) div 60)
 
