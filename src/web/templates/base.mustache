<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{title}}</title>
  <link rel="stylesheet" href="/static/vendor/bootstrap.min.css">
  <link rel="stylesheet" href="/static/app.css">
</head>
<body>
{{#user}}
<nav class="navbar navbar-expand-lg navbar-dark">
  <div class="container-xl">
    <a class="navbar-brand" href="/">在庫管理</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"
            aria-controls="nav" aria-expanded="false" aria-label="メニュー">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="nav">
      <ul class="navbar-nav me-auto">
        <li class="nav-item"><a class="nav-link" href="/blank">無地在庫</a></li>
        <li class="nav-item"><a class="nav-link" href="/printed">プリント済み</a></li>
        <li class="nav-item"><a class="nav-link" href="/receive">入荷</a></li>
        <li class="nav-item"><a class="nav-link" href="/convert">プリント変換</a></li>
        <li class="nav-item"><a class="nav-link" href="/move">出荷・調整</a></li>
        <li class="nav-item"><a class="nav-link" href="/notes">備考</a></li>
        <li class="nav-item"><a class="nav-link" href="/history">履歴</a></li>
        {{#isAdmin}}
        <li class="nav-item"><a class="nav-link" href="/admin/items">品番</a></li>
        <li class="nav-item"><a class="nav-link" href="/admin/categories">カテゴリー</a></li>
        <li class="nav-item"><a class="nav-link" href="/admin/users">ユーザー</a></li>
        {{/isAdmin}}
      </ul>
      <form method="post" action="/logout" class="d-flex align-items-center gap-2">
        <input type="hidden" name="csrf_token" value="{{csrf}}">
        <a class="text-white-50 small" href="/account/password">{{username}}</a>
        <button class="btn btn-sm btn-outline-light">ログアウト</button>
      </form>
    </div>
  </div>
</nav>
{{/user}}
<main class="container-xl pb-5">
  {{> flashes}}{{{content}}}
</main>
<script src="/static/vendor/bootstrap.bundle.min.js"></script>
<script src="/static/app.js"></script>
</body>
</html>
